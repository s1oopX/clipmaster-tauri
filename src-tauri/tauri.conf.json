{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipMaster",
  "version": "0.1.3",
  "identifier": "com.clipmaster.desktop",
  "build": {
    "beforeDevCommand": "node scripts/vite-dev.mjs",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipMaster",
        "width": 440,
        "height": 560,
        "minWidth": 440,
        "minHeight": 560,
        "maxWidth": 440,
        "maxHeight": 560,
        "resizable": false,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/com.clipmaster.desktop/images/**",
            "$APPDATA/com.clipmaster.desktop/screenshot-cache/**"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
